# 可选配置：docker compose --env-file .env.compose up -d --build
# Compose 主机端口与本地 Python 的 PUAA_PORT 分开配置。
PUAA_COMPOSE_PORT=11451
PUAA_BIND_HOST=127.0.0.1
PUAA_SESSION_DAYS=30
PUAA_SECURE_COOKIES=false
PUAA_TRUST_ENV_PROXY=false
PUAA_SYNC_INTERVAL_SECONDS=900
# 留空会在持久化数据卷生成随机密钥；已存凭据后不要随意更换。
PUAA_MASTER_KEY=
